# Conventional Commits: type(scope)!: description
subject=$(grep -v '^#' "$1" | sed '/^[[:space:]]*$/d' | head -n 1)

case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)(\([^()]+\))?!?: [^ ]'; then
  echo "commit-msg: \"$subject\" is not a Conventional Commit." >&2
  echo "commit-msg: write it as type(scope): description, e.g. \"feat(ui): add the sidebar\"." >&2
  echo "commit-msg: types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test." >&2
  exit 1
fi
