{
  "name": "sextou-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "pnpm --filter @sextou/desktop start",
    "package": "pnpm --filter @sextou/desktop package",
    "make": "pnpm --filter @sextou/desktop make",
    "storybook": "pnpm --filter @sextou/ui storybook",
    "build-storybook": "pnpm --filter @sextou/ui build-storybook",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "typescript": "^6.0.3"
  }
}
