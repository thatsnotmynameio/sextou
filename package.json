{
  "name": "sextou-monorepo",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "pnpm --parallel --filter @sextou/web --filter @sextou/desktop run \"/^(dev|start)$/\"",
    "package": "pnpm --filter @sextou/desktop package",
    "make": "pnpm --filter @sextou/desktop make",
    "build": "pnpm package && pnpm --filter @sextou/web build && pnpm build-storybook && pnpm --filter @sextou/server build && pnpm --filter @sextou/runner build",
    "storybook": "pnpm --filter @sextou/ui storybook",
    "build-storybook": "pnpm --filter @sextou/ui build-storybook",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:component": "pnpm -r test:component",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": "oxlint --fix",
    "*": "oxfmt --no-error-on-unmatched-pattern"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
