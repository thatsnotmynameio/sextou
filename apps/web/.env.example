# The web app's settings, each with the default it takes when unset. Copy this
# file to apps/web/.env to change one: `pnpm --filter @sextou/web dev` and
# `build` read it, and settings.ts parses them all. The server's URL and the
# request timeout are written into the bundle, so everything here is public:
# never put a secret in it.

# The server the web app talks to. It must point at the server's
# SEXTOU_SERVER_HOST and SEXTOU_SERVER_PORT (apps/server/.env.example).
SEXTOU_WEB_SERVER_URL=http://127.0.0.1:4310

# How long a request to the server may take, in milliseconds, before the page
# says the server can't be reached. Keep it above the server's
# SEXTOU_SERVER_DATABASE_TIMEOUT_MS, so a database that hangs shows as down.
SEXTOU_WEB_REQUEST_TIMEOUT_MS=30000

# The dev server's port. The server's SEXTOU_SERVER_WEB_ORIGIN and the
# desktop's SEXTOU_WEB_URL (apps/desktop/.env.example) must name the origin it
# makes, http://localhost:5173 by default. When the server's doesn't, the
# browser refuses the server's answers and the page says the server can't be
# reached.
SEXTOU_WEB_PORT=5173
