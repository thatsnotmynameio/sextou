# The desktop's settings. Copy this file to apps/desktop/.env to change one in
# development, where `pnpm start` reads it. Packaging reads SEXTOU_WEB_URL only
# from the environment it runs in, never from this file.

# The web app the window loads. Unset in development, it is apps/web's dev
# server, http://localhost:5173: keep it on the origin of the web app's
# SEXTOU_WEB_PORT (apps/web/.env.example), which the server's
# SEXTOU_SERVER_WEB_ORIGIN (apps/server/.env.example) must name too. A packaged
# build needs an https URL, and opens on its error page when it is unset.
SEXTOU_WEB_URL=http://localhost:5173
