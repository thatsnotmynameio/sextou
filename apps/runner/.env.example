# The runner's settings, each with the default it takes when unset. Copy this
# file to apps/runner/.env to change one in development: `pnpm --filter
# @sextou/runner dev` reads it. src/config.ts reads them all.

# The server the runner talks to. It must point at the server's
# SEXTOU_SERVER_HOST and SEXTOU_SERVER_PORT (apps/server/.env.example).
SEXTOU_RUNNER_SERVER_URL=http://127.0.0.1:4310

# The runner's name, which the server records on each claim and completion.
# Unset, it is the machine's hostname.
# SEXTOU_RUNNER_NAME=

# The assignees whose tasks the runner takes, separated by commas. Unset, it
# is the runner's name alone.
# SEXTOU_RUNNER_ASSIGNEES=

# How long a call to the server may take, in milliseconds, before the runner
# counts it as unanswered and sends it again. Keep it above the server's
# SEXTOU_SERVER_TASKS_TIMEOUT_MS, so the server answers before the runner
# gives up.
SEXTOU_RUNNER_REQUEST_TIMEOUT_MS=30000

# How long the runner waits, in milliseconds, before it claims again when
# there was no task or no answer, and before it sends a completion again.
SEXTOU_RUNNER_POLL_MS=5000

# go-task's binary, which runs the Taskfile each claim carries: a command on
# the PATH or a path. Some distributions name it go-task. The runner renews
# the lease every third of the server's SEXTOU_SERVER_LEASE_MS while the run
# lasts, and stops the run when someone asks to cancel its task.
SEXTOU_RUNNER_TASK_BIN=task

# How long go-task may take to print its help, in milliseconds, when the
# runner starts and checks that SEXTOU_RUNNER_TASK_BIN is go-task. The runner
# exits with 1 when it isn't, before it calls the server.
SEXTOU_RUNNER_CHECK_TIMEOUT_MS=10000

# How long a run may take, in milliseconds, before the runner stops it and
# completes its task as failed, with the reason timeout.
SEXTOU_RUNNER_RUN_TIMEOUT_MS=21600000

# How long a stopped run has to exit after SIGTERM, in milliseconds, before
# the runner kills it with SIGKILL. Also how long a run's output may stay open
# once go-task exited, stopped or not, as when a command it started in the
# background keeps it: a longer grace delays those runs' completion.
SEXTOU_RUNNER_KILL_GRACE_MS=10000

# true writes readable log lines instead of JSON. Set it in apps/runner/.env
# for development.
SEXTOU_RUNNER_DEV=false

# The lowest level the runner logs: fatal, error, warn, info, debug, trace or
# silent. It writes one JSON line per record to stdout; each heartbeat is a
# debug record.
SEXTOU_RUNNER_LOG_LEVEL=info
