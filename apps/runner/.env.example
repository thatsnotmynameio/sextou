# The runner's settings, each with the default it takes when unset. Copy this
# file to apps/runner/.env to change one in development: `pnpm --filter
# @sextou/runner dev` and `start` read it. src/config.ts reads them all.

# The server the runner asks for tasks: http or https. It must point at the
# server's SEXTOU_SERVER_HOST and SEXTOU_SERVER_PORT (apps/server/.env.example).
SEXTOU_RUNNER_SERVER_URL=http://127.0.0.1:4310

# How long the runner waits after each request, in milliseconds, before it
# asks again.
SEXTOU_RUNNER_POLL_INTERVAL_MS=1000

# How long a request may wait for the server, in milliseconds, before the
# runner counts it as failed. Keep it above the server's
# SEXTOU_SERVER_DATABASE_TIMEOUT_MS, so the server answers before the runner
# gives up.
SEXTOU_RUNNER_REQUEST_TIMEOUT_MS=30000

# true writes readable log lines instead of JSON. Set it in apps/runner/.env
# for development.
SEXTOU_RUNNER_DEV=false

# The lowest level the runner logs: fatal, error, warn, info, debug, trace or
# silent. It writes one JSON line per record to stdout. A failed request is
# logged at warn, every other record at info.
SEXTOU_RUNNER_LOG_LEVEL=info
