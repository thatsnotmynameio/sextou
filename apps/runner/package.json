{
  "name": "@sextou/runner",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx --env-file-if-exists=.env src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.mts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@trpc/client": "^11.19.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0"
  },
  "devDependencies": {
    "@sextou/server": "workspace:*",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@trpc/server": "^11.19.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
