# The server's settings, each with the default it takes when unset. Copy this
# file to apps/server/.env to change one in development: `pnpm --filter
# @sextou/server dev` and `start` read it. src/config.ts reads them all.

# Where the server listens. The web app's SEXTOU_WEB_SERVER_URL
# (apps/web/.env.example) must point at this host and port.
SEXTOU_SERVER_HOST=127.0.0.1
SEXTOU_SERVER_PORT=4310

# The folder that holds the database and the tasks database. Unset, it is
# apps/server/storage from source (`dev`), so each checkout has its own, and in
# the build (`start`) sextou in the user's data directory: ~/.local/share on
# Linux, ~/Library/Application Support on macOS, %LOCALAPPDATA% on Windows.
# SEXTOU_SERVER_DATA_DIR=

# The database file, or :memory:. Unset, it is sextou.db in the data folder.
# SEXTOU_SERVER_DATABASE=

# The tasks database's file, or :memory:. Unset, it is tasks.db in the data folder.
# SEXTOU_SERVER_TASKS_DB=

# The web app's origin, the only one allowed to read the server's answers. It
# must name the same origin as the web app's SEXTOU_WEB_PORT and the desktop's
# SEXTOU_WEB_URL. When it doesn't, the browser refuses the answers and the
# health page says the server can't be reached.
SEXTOU_SERVER_WEB_ORIGIN=http://localhost:5173

# How long a database query may take, in milliseconds, before health reports
# the database down. Keep it below the web app's SEXTOU_WEB_REQUEST_TIMEOUT_MS,
# so a database that hangs shows as down rather than as a server that can't be
# reached.
SEXTOU_SERVER_DATABASE_TIMEOUT_MS=20000

# How long a call to the tasks database may take, in milliseconds, waiting
# for another call included. One past it writes nothing and fails with
# TIMEOUT. Keep it below the web app's SEXTOU_WEB_REQUEST_TIMEOUT_MS and the
# runners' own request timeout, so the server answers before they give up.
SEXTOU_SERVER_TASKS_TIMEOUT_MS=20000

# How long a runner's lease on a task lasts, in milliseconds, unless its
# heartbeat renews it. A runner renews it every third of this, which claim and
# each heartbeat answer with. The server ends no lease until it has been up
# this long, and waits this long again after a sweep that ran a third of it
# late, so the runners renew first.
SEXTOU_SERVER_LEASE_MS=30000

# How many attempts a task gets. When a lease expires, the task is cancelled
# if someone asked to cancel it; else it opens again while attempts are left,
# and fails once they run out: 1 fails it at the first expired lease.
SEXTOU_SERVER_MAX_ATTEMPTS=1

# How often the server ends the attempts whose lease expired, in
# milliseconds, counted from the end of the last sweep. Keep it below
# SEXTOU_SERVER_LEASE_MS, so an expired lease ends soon after it runs out.
SEXTOU_SERVER_LEASE_SWEEP_MS=5000

# true adds the stack to error responses and writes readable log lines
# instead of JSON. Set it in apps/server/.env for development.
SEXTOU_SERVER_DEV=false

# The lowest level the server logs: fatal, error, warn, info, debug, trace or
# silent. It writes one JSON line per record to stdout. At warn and above it
# drops the record that says where it listens, which a process that starts the
# server reads for the URL.
SEXTOU_SERVER_LOG_LEVEL=info
