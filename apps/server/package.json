{
  "name": "@sextou/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "vite build",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.mts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:mutation": "stryker run && node ../../.github/scripts/src/mutation-floor-cli.ts reports/mutation/mutation.json"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@sextou/contract": "workspace:*",
    "@sextou/core": "workspace:*",
    "@sextou/data": "workspace:*",
    "@sextou/tasks": "workspace:*",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
