{
  "name": "@sextou/server",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./router": "./src/router.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.mts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@sextou/config": "workspace:*",
    "@sextou/logger": "workspace:*",
    "@sextou/tasks": "workspace:*",
    "@trpc/server": "^11.19.0",
    "@tursodatabase/database": "0.8.3",
    "drizzle-orm": "1.0.0-rc.5",
    "hono": "^4.13.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
