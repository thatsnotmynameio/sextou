{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn"
  },
  "overrides": [
    {
      "files": ["apps/web/**", "packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app and the shared UI run in a browser too: reach native features through apps/web/src/platform.ts."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "The web app and the shared UI run in a browser too: reach native features through apps/web/src/platform.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/modules/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/**",
                  "!../*/index",
                  "!../../**",
                  "../../modules/*/**",
                  "!../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/modules/*/*/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../*/**",
                  "!../../*/index",
                  "!../../../**",
                  "../../../modules/*/**",
                  "!../../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    }
  ]
}
