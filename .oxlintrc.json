{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["apps/web/src/routeTree.gen.ts"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "vitest",
    "import"
  ],
  "categories": {
    "correctness": "warn"
  },
  "rules": {
    "typescript/no-import-type-side-effects": "error",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/exhaustive-effect-dependencies": "error",
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-activedescendant-has-tabindex": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/autocomplete-valid": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/html-has-lang": "error",
    "jsx-a11y/iframe-has-title": "error",
    "jsx-a11y/img-redundant-alt": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/media-has-caption": "error",
    "jsx-a11y/mouse-events-have-key-events": "error",
    "jsx-a11y/no-access-key": "error",
    "jsx-a11y/no-autofocus": "error",
    "jsx-a11y/no-distracting-elements": "error",
    "jsx-a11y/no-interactive-element-to-noninteractive-role": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "error",
    "jsx-a11y/no-noninteractive-element-to-interactive-role": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/no-static-element-interactions": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/scope": "error",
    "jsx-a11y/tabindex-no-positive": "error",
    "vitest/expect-expect": "error",
    "vitest/no-commented-out-tests": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error",
    "vitest/no-identical-title": "error",
    "vitest/no-import-node-test": "error",
    "vitest/require-local-test-context-for-concurrent-snapshots": "error",
    "vitest/valid-describe-callback": "error",
    "vitest/valid-expect": "error",
    "vitest/valid-title": "error",
    "import/no-cycle": "error",
    "vitest/no-conditional-expect": "off",
    "vitest/no-standalone-expect": "off",
    "vitest/require-mock-type-parameters": "off",
    "vitest/require-to-throw-message": "off"
  },
  "overrides": [
    {
      "files": ["packages/ui/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/modules/*/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../*/**",
                  "!../*/index",
                  "!../../**",
                  "../../modules/*/**",
                  "!../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/src/modules/*/*/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "../../*/**",
                  "!../../*/index",
                  "!../../../**",
                  "../../../modules/*/**",
                  "!../../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "name": "@sextou/server",
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "group": ["@sextou/server/*"],
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/runner/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@sextou/server",
                "message": "The runner takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["@sextou/server/*"],
                "message": "The runner takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/modules/*/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "name": "@sextou/server",
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "group": ["@sextou/server/*"],
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              },
              {
                "group": [
                  "../*/**",
                  "!../*/index",
                  "!../../**",
                  "../../modules/*/**",
                  "!../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/src/modules/*/*/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "electron",
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "name": "@sextou/server",
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["electron/*"],
                "message": "The web app and the shared UI run in a browser too: reach native features through web APIs, which Electron maps in the desktop window, or through what the preload exposes."
              },
              {
                "group": ["@sextou/server/*"],
                "message": "The web app takes only types from the server: import type { … } from it.",
                "allowTypeImports": true
              },
              {
                "group": [
                  "../../*/**",
                  "!../../*/index",
                  "!../../../**",
                  "../../../modules/*/**",
                  "!../../../modules/*/index"
                ],
                "message": "A module reaches another module only through its entry point, the index.ts in its folder."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/tests/go-task.ts"],
      "rules": {
        "vitest/expect-expect": "off",
        "vitest/no-disabled-tests": "off",
        "vitest/valid-title": "off"
      }
    }
  ]
}
