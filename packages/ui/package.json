{
  "name": "@sextou/ui",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./theme.css": "./src/theme.css",
    "./lingui-macros": "./lingui-macros.ts"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:component",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:component": "vitest run --config vitest.component.config.ts --coverage --coverage.reportsDirectory=coverage/component",
    "test:mutation": "stryker run"
  },
  "peerDependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@lingui/native-tools": "^0.2.0",
    "daisyui": "^5.7.50",
    "lucide-react": "^1.62.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@lingui/core": "^6.10.0",
    "@lingui/message-utils": "^6.10.0",
    "@lingui/react": "^6.10.0",
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/react-vite": "^10.6.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
