{
  "name": "@sextou/data",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migration": "node scripts/migration.ts",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:mutation": "stryker run && node ../../.github/scripts/src/mutation-floor-cli.ts reports/mutation/mutation.json"
  },
  "dependencies": {
    "@tursodatabase/database": "0.8.3",
    "drizzle-orm": "1.0.0-rc.4"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "1.0.0-rc.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
