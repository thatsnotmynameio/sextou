{
  "name": "@sextou/tasks",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --coverage --coverage.reportsDirectory=coverage/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts --coverage --coverage.reportsDirectory=coverage/integration",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@tursodatabase/database": "0.8.3",
    "drizzle-orm": "1.0.0-rc.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "1.0.0-rc.5",
    "pino": "^10.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
