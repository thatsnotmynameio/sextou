{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": [
    "apps/*/src/**/*",
    "apps/*/*.mts",
    "packages/*/src/**/*",
    "packages/*/.storybook/**/*",
    "packages/*/*.ts"
  ]
}
